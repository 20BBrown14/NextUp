# Copy to config.test.env and fill in the two Jellyfin values after completing
# the first-boot wizard. config.test.env is gitignored; this sample is not.
#
# Only the settings needed to exercise AUTO_CREATE_RECOMMENDATION_LIBRARIES are
# included. TMDB/WatchState/Seerr are left blank so a run focuses on the library
# creation path; add them if you want full recommendation generation.

###################################
#            JELLYFIN             #
###################################
# Create under Dashboard > API Keys in the test Jellyfin.
JELLYFIN_API_KEY=
# Reachable from inside the nextup container. On the compose network the
# jellyfin service is addressable by its service name.
JELLYFIN_URL=http://jellyfin:8096

###################################
#              TMDB               #
###################################
TMDB_API_KEY=
TMDB_URL=https://api.themoviedb.org/3

###################################
#             NextUp              #
###################################
NEXTUP_RECOMMENDATIONS_DIR=/recommendations
PLACEHOLDER_FILE_PATH=/movie.mp4

###################################
#         RECOMMENDATIONS         #
###################################
# No cron: run on demand via POST /recommendations/run so tests are deterministic.
RECOMMENDATIONS_CRON_SCHEDULE=
# Match this to a user that exists in the test Jellyfin (the wizard admin works).
GENERATE_RECOS_FOR=
LANGUAGE=en
ENFORCE_ORIG_LANGUAGE=false
AUTO_CREATE_RECOMMENDATION_LIBRARIES=true

## Series
DISABLE_SERIES_RECOMMENDATIONS=false
MAX_SERIES_DAYS_LOOKBACK=7
MAX_RECOMMENDATIONS_PER_SERIES=5
MIN_EPISODE_WATCH_COUNT=1
MAX_TOTAL_SERIES_RECOMMENDATIONS=5
INCLUDE_POPULAR_SERIES_RECOMMENDATIONS=false
POPULAR_SERIES_COUNT=5

## Movies
DISABLE_MOVIE_RECOMMENDATIONS=false
MAX_MOVIE_DAYS_LOOKBACK=7
MAX_RECOMMENDATIONS_PER_MOVIE=1
MIN_MOVIE_WATCH_PERCENT=90
MAX_TOTAL_MOVIE_RECOMMENDATIONS=5
INCLUDE_POPULAR_MOVIE_RECOMMENDATIONS=false
INCLUDE_UPCOMING_MOVIE_RECOMMENDATIONS=false
POPULAR_MOVIES_COUNT=10
UPCOMING_MOVIES_COUNT=10
